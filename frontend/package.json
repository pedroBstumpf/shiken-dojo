{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-shiken-dojo",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shiken-dojo \"vitest run --config vitest.rules.config.mjs\"",
    "deploy": "npm run build && firebase deploy --only firestore,hosting",
    "build:emulator": "ng build --configuration production,emulator"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/material-date-fns-adapter": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "@fontsource/shippori-mincho": "^5.3.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.2.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
