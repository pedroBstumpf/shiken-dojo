rules_version = '2';

// Quem protege os dados é este arquivo, e não o app: o código e a chave de API são públicos.
// Regra geral: só quem tem e-mail comprovado E cadastro ativo em /teachers lê ou grava.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Criar conta é aberto no Firebase. Exigir e-mail comprovado impede alguém de registrar o
    // e-mail de um professor antes dele e herdar o cadastro.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function me() {
      return get(/databases/$(database)/documents/teachers/$(myEmail())).data;
    }

    function isTeacher() {
      return verified() && me().active == true;
    }

    function isHead() {
      return isTeacher() && me().role == 'head_instructor';
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validBelt(value) {
      return value in ['branca', 'amarela', 'vermelha', 'laranja', 'verde', 'roxa', 'marrom', 'preta'];
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 120;
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validTeacher(data) {
      return validName(data.fullName)
        && data.phone is string && data.phone.matches('^([0-9]{10,11})?$')
        && data.role in ['head_instructor', 'instructor']
        && validBelt(data.belt)
        && ((data.belt == 'preta' && data.dan is int && data.dan >= 1 && data.dan <= 10)
            || (data.belt != 'preta' && data.dan == null))
        && data.federationId is string && data.federationId.size() <= 30
        && data.active is bool;
    }

    // O identificador do cadastro é o e-mail em minúsculas.
    match /teachers/{email} {
      // Cada um lê o próprio cadastro (é como o app descobre se está inativo).
      allow read: if verified() && (email == myEmail() || isTeacher());

      // Qualquer professor convida; só o sensei responsável pode criar outro sensei responsável.
      allow create: if isTeacher()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly([
             'fullName', 'email', 'phone', 'role', 'belt', 'dan', 'federationId', 'active',
             'invitationPending', 'createdAt', 'updatedAt'
           ])
        && validTeacher(request.resource.data)
        && request.resource.data.invitationPending == true
        && request.resource.data.active == true
        && (isHead() || request.resource.data.role == 'instructor');

      // O sensei responsável não muda o próprio papel nem se desativa: assim o dojo nunca fica
      // sem um responsável. O e-mail nunca muda, porque é o identificador do login.
      allow update: if (
          isHead()
          && changed().hasOnly([
               'fullName', 'phone', 'role', 'belt', 'dan', 'federationId', 'active', 'updatedAt'
             ])
          && validTeacher(request.resource.data)
          && (email != myEmail() || !changed().hasAny(['role', 'active']))
        ) || (
          // No primeiro acesso, o próprio professor marca o convite como aceito.
          isTeacher()
          && email == myEmail()
          && changed().hasOnly(['invitationPending', 'updatedAt'])
          && request.resource.data.invitationPending == false
        );

      allow delete: if isHead() && email != myEmail();
    }

    match /students/{id} {
      allow read, delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly([
             'fullName', 'belt', 'birthDate', 'createdAt', 'updatedAt'
           ])
        && validName(request.resource.data.fullName)
        && validBelt(request.resource.data.belt)
        && (request.resource.data.birthDate == null || validDate(request.resource.data.birthDate));
    }

    match /exams/{id} {
      function validStatus(data) {
        return (data.status == 'draft' && data.completedAt == null)
          || (data.status == 'completed' && data.completedAt is timestamp);
      }

      allow read: if isTeacher();

      // Prova finalizada é imutável: não pode ser alterada nem excluída por ninguém.
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly([
             'templateId', 'templateName', 'fromBelt', 'toBelt', 'sections', 'date', 'location',
             'examinerId', 'examinerName', 'passingGrade', 'notes', 'participants', 'grades',
             'status', 'completedAt', 'createdAt', 'updatedAt'
           ])
        && validBelt(request.resource.data.fromBelt)
        && validBelt(request.resource.data.toBelt)
        && validDate(request.resource.data.date)
        && request.resource.data.passingGrade is number
        && request.resource.data.passingGrade >= 0
        && request.resource.data.passingGrade <= 3
        && request.resource.data.sections is list
        && request.resource.data.participants is list
        && request.resource.data.grades is map
        && validStatus(request.resource.data);

      allow update: if isTeacher()
        && resource.data.status == 'draft'
        && changed().hasOnly(['grades', 'status', 'completedAt', 'updatedAt'])
        && request.resource.data.grades is map
        && validStatus(request.resource.data);

      allow delete: if isTeacher() && resource.data.status == 'draft';
    }

    // Registro dos PDFs gerados pelo app. A importação só aceita um PDF cujo conteúdo (hash)
    // esteja aqui, o que recusa arquivos de outra origem ou alterados depois de exportados.
    match /pdfExports/{hash} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['examId', 'variant', 'createdBy', 'createdAt'])
        && request.resource.data.examId is string
        && request.resource.data.variant in ['filled', 'blank']
        && request.resource.data.createdBy == myEmail();
    }
  }
}
