# Copie para .env e ajuste. Nunca versione o .env (BACKEND.md §12).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Quantos proxies confiáveis existem na frente da API (0 = acesso direto).
TRUST_PROXY_HOPS=0
# Origens com CORS liberado, separadas por vírgula. Vazio = só a mesma origem (recomendado).
CORS_ORIGINS=
# Requisições por minuto, por IP, em toda a API.
RATE_LIMIT_PER_MINUTE=300

# Banco de dados. Em desenvolvimento, `npm run db:setup` preenche estas variáveis.
# API: papel com apenas SELECT/INSERT/UPDATE/DELETE.
DATABASE_URL=
# Migrações: papel dono do schema (usado só por `npm run db:migrate`).
MIGRATION_DATABASE_URL=
# Banco separado para os testes automatizados.
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=

# Sessão e segurança
# Cookies só por HTTPS (padrão: ligado em produção, onde é obrigatório).
COOKIE_SECURE=
# Chave do token anti-CSRF (32+ caracteres aleatórios). `npm run db:setup` gera uma para dev.
CSRF_SECRET=
# Encerra a sessão após este tempo sem uso (minutos) e após este tempo total (horas).
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=168
# Recusa senhas que aparecem em vazamentos (Have I Been Pwned, por k-anonymity).
BREACHED_PASSWORD_CHECK=true

# Endereço do front-end, usado nos links enviados por e-mail (convites).
APP_BASE_URL=http://localhost:4200
# E-mail: smtp = envio real (obrigatório em produção); file = grava .eml em MAIL_FILE_DIR.
MAIL_TRANSPORT=file
SMTP_URL=
MAIL_FROM=Shiken Dojo <nao-responda@shiken-dojo.app>
MAIL_FILE_DIR=.local/mail

# Desenvolvimento: senha dos professores de demonstração (`npm run db:seed`).
SEED_PASSWORD=
